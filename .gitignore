# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android build cache and CMake artifacts
**/android/app/.cxx/
**/android/.gradle/
android/app/.cxx/
android/.gradle/

# Environment variables and secrets
.env
.env.*
*.key
*.pem
credentials.json
secrets.json

# Never commit passwords or API keys
*password*
*secret*
*token*
# Exception: allow test files to exist
!*_test.dart
!test/**
!integration_test/**

# Maestro test outputs
.maestro/tests/

# Test coverage reports
coverage/
test/coverage/
*.lcov

# Node.js dependencies specific to Netlify functions
netlify/functions/node_modules/

# Netlify build artifacts
.netlify/

# Local configuration
local.properties
