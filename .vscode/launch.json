{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dev - Autosignin (Demo/QA)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_development.dart",
      "args": [
        "--flavor",
        "development",
        "--target",
        "lib/main_development.dart",
        "--dart-define=CLIENT_ID=${env:MEMVERSE_CLIENT_ID}",
        "--dart-define=POSTHOG_MEMVERSE_API_KEY=${env:POSTHOG_MEMVERSE_API_KEY}",
        "--dart-define=MEMVERSE_CLIENT_API_KEY=${env:MEMVERSE_CLIENT_API_KEY}",
        "--dart-define=AUTOSIGNIN=true"
      ]
    },
    {
      "name": "Dev - Real Login",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_development.dart",
      "args": [
        "--flavor",
        "development",
        "--target",
        "lib/main_development.dart",
        "--dart-define=CLIENT_ID=${env:MEMVERSE_CLIENT_ID}",
        "--dart-define=POSTHOG_MEMVERSE_API_KEY=${env:POSTHOG_MEMVERSE_API_KEY}",
        "--dart-define=MEMVERSE_CLIENT_API_KEY=${env:MEMVERSE_CLIENT_API_KEY}",
        "--dart-define=AUTOSIGNIN=false"
      ]
    },
    {
      "name": "Staging",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_staging.dart",
      "args": [
        "--flavor",
        "staging",
        "--target",
        "lib/main_staging.dart",
        "--dart-define=CLIENT_ID=${env:MEMVERSE_CLIENT_ID}",
        "--dart-define=POSTHOG_MEMVERSE_API_KEY=${env:POSTHOG_MEMVERSE_API_KEY}",
        "--dart-define=MEMVERSE_CLIENT_API_KEY=${env:MEMVERSE_CLIENT_API_KEY}"
      ]
    },
    {
      "name": "Production",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_production.dart",
      "args": [
        "--flavor",
        "production",
        "--target",
        "lib/main_production.dart",
        "--dart-define=CLIENT_ID=${env:MEMVERSE_CLIENT_ID}",
        "--dart-define=POSTHOG_MEMVERSE_API_KEY=${env:POSTHOG_MEMVERSE_API_KEY}",
        "--dart-define=MEMVERSE_CLIENT_API_KEY=${env:MEMVERSE_CLIENT_API_KEY}"
      ]
    }
  ]
}